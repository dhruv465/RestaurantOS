PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/restaurantOS
# production hides error details and sends cookies only over HTTPS
NODE_ENV=production
# required; 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# extra web addresses allowed to call the API, comma separated (e.g. the address phones use)
CORS_ORIGINS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
